pipeline {
    agent any

    parameters {
        choice(
            name: 'APPLICATION',
            choices: [
                'inventory-api',
                'inventory-web',
                'reporting-service'
            ],
            description: 'Application to build and deploy'
        )

        string(
            name: 'VERSION',
            defaultValue: '1.4.2',
            description: 'Immutable release version'
        )

        choice(
            name: 'TARGET_ENV',
            choices: [
                'dev',
                'qa',
                'staging',
                'prod'
            ],
            description: 'Deployment environment'
        )

        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Skip manual production approval'
        )

        string(
            name: 'SIMULATE_FAILURE',
            defaultValue: 'false',
            description: 'Set to true to test deployment failure and rollback'
        )
    }

    environment {
        BASE_DIR = "${WORKSPACE}"

        NEXUS_URL = 'http://localhost:8081/repository/nexora-releases'
        SONAR_HOST = 'http://localhost:9000'

        NEXUS_CREDS = credentials('nexus')
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    set -e

                    echo "========================================"
                    echo "Checkout"
                    echo "========================================"

                    git rev-parse --short HEAD
                    git status --short
                '''
            }
        }

        stage('Validate Release') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Release Validation"
                    echo "========================================"

                    test -n "${APPLICATION}"
                    test -n "${VERSION}"
                    test -n "${TARGET_ENV}"

                    case "${APPLICATION}" in
                        inventory-api|inventory-web|reporting-service)
                            ;;
                        *)
                            echo "ERROR: Unsupported application"
                            exit 1
                            ;;
                    esac

                    case "${TARGET_ENV}" in
                        dev|qa|staging|prod)
                            ;;
                        *)
                            echo "ERROR: Unsupported environment"
                            exit 1
                            ;;
                    esac

                    echo "Application : ${APPLICATION}"
                    echo "Version     : ${VERSION}"
                    echo "Environment : ${TARGET_ENV}"
                '''
            }
        }

        stage('Build / Test / Sonar') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "========================================"
                        echo "Build / Test / Sonar"
                        echo "========================================"

                        export PATH="$PATH:$HOME/.dotnet/tools"

                        SONAR_SCANNER_VERSION="5.15.0"

                        echo "Installing SonarScanner for .NET ${SONAR_SCANNER_VERSION}"

                        dotnet tool install \
                            --global \
                            dotnet-sonarscanner \
                            --version "${SONAR_SCANNER_VERSION}" \
                            --ignore-failed-sources \
                            || true

                        command -v dotnet-sonarscanner

                        echo "Starting SonarQube analysis"

                        dotnet-sonarscanner begin \
                            /k:"nexora-${APPLICATION}" \
                            /n:"Nexora ${APPLICATION}" \
                            /d:sonar.host.url="${SONAR_HOST}" \
                            /d:sonar.token="${SONAR_TOKEN}" \
                            /d:sonar.qualitygate.wait=false \
                            /d:sonar.scanner.skipJreProvisioning=true \
                            /d:sonar.http.timeout=300

                        case "${APPLICATION}" in

                            inventory-api)

                                cd applications/inventory-api

                                rm -rf publish

                                dotnet restore

                                dotnet build \
                                    --configuration Release \
                                    --no-restore

                                dotnet test \
                                    --configuration Release \
                                    --no-build

                                dotnet publish \
                                    --configuration Release \
                                    --no-build \
                                    --output ./publish
                                ;;

                            inventory-web)

                                cd applications/inventory-web

                                npm ci

                                npm run build
                                ;;

                            reporting-service)

                                cd applications/reporting-service

                                mvn clean test package
                                ;;

                        esac

                        echo "Completing SonarQube analysis"

                        dotnet-sonarscanner end \
                            /d:sonar.token="${SONAR_TOKEN}"
                    '''
                }
            }
        }

        stage('Sonar Quality Gate') {
            steps {
                script {

                    def maxAttempts = 12
                    def attempt = 0
                    def gatePassed = false

                    echo "Waiting for SonarQube quality gate..."

                    while (attempt < maxAttempts && !gatePassed) {

                        attempt++

                        sh """
                            echo "SonarQube quality gate check attempt ${attempt}/${maxAttempts}"
                        """

                        def result = sh(
                            script: '''
                                set +e

                                RESPONSE=$(curl -s \
                                    -u "${SONAR_TOKEN}:" \
                                    "${SONAR_HOST}/api/qualitygates/project_status?projectKey=nexora-${APPLICATION}")

                                echo "${RESPONSE}" > sonar-quality-gate.json

                                STATUS=$(echo "${RESPONSE}" | \
                                    sed -n 's/.*"projectStatus":{"status":"\\([^"]*\\)".*/\\1/p')

                                echo "Quality Gate Status: ${STATUS}"

                                if [ "${STATUS}" = "OK" ]; then
                                    exit 0
                                fi

                                if [ "${STATUS}" = "ERROR" ]; then
                                    exit 2
                                fi

                                exit 1
                            ''',
                            returnStatus: true
                        )

                        if (result == 0) {
                            gatePassed = true
                        } else if (result == 2) {
                            error("SonarQube Quality Gate FAILED")
                        } else {
                            sleep(time: 5, unit: 'SECONDS')
                        }
                    }

                    if (!gatePassed) {
                        error("SonarQube Quality Gate did not return OK within timeout")
                    }
                }
            }
        }

        stage('Generate SBOM') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Generating SBOM"
                    echo "========================================"

                    mkdir -p build/sbom

                    case "${APPLICATION}" in

                        inventory-api)
                            cd applications/inventory-api

                            dotnet list package \
                                --format json \
                                > "${WORKSPACE}/build/sbom/${APPLICATION}-${VERSION}-dotnet-packages.json"
                            ;;

                        inventory-web)
                            cd applications/inventory-web

                            npm list \
                                --all \
                                --json \
                                > "${WORKSPACE}/build/sbom/${APPLICATION}-${VERSION}-npm-packages.json"
                            ;;

                        reporting-service)
                            cd applications/reporting-service

                            mvn dependency:tree \
                                -DoutputFile="${WORKSPACE}/build/sbom/${APPLICATION}-${VERSION}-maven-dependencies.txt"
                            ;;

                    esac
                '''
            }
        }

        stage('Package') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Package Release"
                    echo "========================================"

                    mkdir -p build/release

                    case "${APPLICATION}" in

                        inventory-api)

                            cd applications/inventory-api

                            rm -f "${WORKSPACE}/build/release/${APPLICATION}-${VERSION}.zip"

                            (
                                cd publish
                                zip -qr \
                                    "${WORKSPACE}/build/release/${APPLICATION}-${VERSION}.zip" \
                                    .
                            )
                            ;;

                        inventory-web)

                            cd applications/inventory-web

                            rm -f "${WORKSPACE}/build/release/${APPLICATION}-${VERSION}.zip"

                            (
                                cd dist
                                zip -qr \
                                    "${WORKSPACE}/build/release/${APPLICATION}-${VERSION}.zip" \
                                    .
                            )
                            ;;

                        reporting-service)

                            cp \
                                applications/reporting-service/target/*.jar \
                                "build/release/${APPLICATION}-${VERSION}.jar"
                            ;;

                    esac

                    cd build/release

                    sha256sum \
                        "${APPLICATION}-${VERSION}"* \
                        > "${APPLICATION}-${VERSION}.sha256"

                    echo
                    echo "Release artifacts:"
                    ls -lh
                '''
            }
        }

        stage('Publish to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "========================================"
                        echo "Publishing Immutable Artifact to Nexus"
                        echo "========================================"

                        ARTIFACT_NAME="${APPLICATION}-${VERSION}"

                        if [ "${APPLICATION}" = "reporting-service" ]; then
                            EXTENSION="jar"
                        else
                            EXTENSION="zip"
                        fi

                        ARTIFACT_FILE="build/release/${ARTIFACT_NAME}.${EXTENSION}"
                        CHECKSUM_FILE="build/release/${ARTIFACT_NAME}.sha256"

                        TARGET_URL="${NEXUS_URL}/${APPLICATION}/${VERSION}/"

                        echo "Target: ${TARGET_URL}"

                        curl --fail --silent --show-error \
                            -u "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                            -T "${ARTIFACT_FILE}" \
                            "${TARGET_URL}${ARTIFACT_NAME}.${EXTENSION}"

                        curl --fail --silent --show-error \
                            -u "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                            -T "${CHECKSUM_FILE}" \
                            "${TARGET_URL}${ARTIFACT_NAME}.sha256"

                        echo
                        echo "Verifying immutable artifact"

                        HTTP_CODE=$(curl \
                            -s \
                            -o /dev/null \
                            -w "%{http_code}" \
                            -u "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                            "${TARGET_URL}${ARTIFACT_NAME}.${EXTENSION}")

                        if [ "${HTTP_CODE}" != "200" ]; then
                            echo "ERROR: Nexus artifact verification failed"
                            exit 1
                        fi

                        echo "Nexus artifact verification: SUCCESS"
                    '''
                }
            }
        }

        stage('Approval') {
            when {
                expression {
                    return params.TARGET_ENV == 'prod' &&
                           !params.AUTO_APPROVE
                }
            }

            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Deploy ${APPLICATION} ${VERSION} to PROD?"
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ansible-windows',
                        usernameVariable: 'ANSIBLE_USER',
                        passwordVariable: 'ANSIBLE_PASSWORD'
                    ),
                    usernamePassword(
                        credentialsId: 'nexus',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    ),
                    string(
                        credentialsId: 'postgres-db',
                        variable: 'DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "========================================"
                        echo "Deploy"
                        echo "========================================"

                        cd "${WORKSPACE}"

                        export ANSIBLE_USER
                        export ANSIBLE_PASSWORD
                        export NEXUS_USER
                        export NEXUS_PASSWORD
                        export DB_PASSWORD

                        chmod +x ./cli/devopsctl/devopsctl

                        ./cli/devopsctl/devopsctl deploy \
                            "${APPLICATION}" \
                            "${VERSION}" \
                            --env "${TARGET_ENV}" \
                            --simulate-failure "${SIMULATE_FAILURE}"
                    '''
                }
            }
        }

        stage('Health Check / Rollback') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ansible-windows',
                        usernameVariable: 'ANSIBLE_USER',
                        passwordVariable: 'ANSIBLE_PASSWORD'
                    ),
                    usernamePassword(
                        credentialsId: 'nexus',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    ),
                    string(
                        credentialsId: 'postgres-db',
                        variable: 'DB_PASSWORD'
                    )
                ]) {
                    script {

                        def healthResult = sh(
                            script: '''
                                set +e

                                echo "========================================"
                                echo "Post-Deployment Health Check"
                                echo "========================================"

                                case "${APPLICATION}" in
                                    inventory-api)
                                        PORT=8101
                                        ;;
                                    inventory-web)
                                        PORT=8201
                                        ;;
                                    reporting-service)
                                        PORT=8301
                                        ;;
                                esac

                                if [ "${TARGET_ENV}" = "qa" ]; then
                                    case "${APPLICATION}" in
                                        inventory-api) PORT=8102 ;;
                                        inventory-web) PORT=8202 ;;
                                        reporting-service) PORT=8302 ;;
                                    esac
                                elif [ "${TARGET_ENV}" = "staging" ]; then
                                    case "${APPLICATION}" in
                                        inventory-api) PORT=8103 ;;
                                        inventory-web) PORT=8203 ;;
                                        reporting-service) PORT=8303 ;;
                                    esac
                                elif [ "${TARGET_ENV}" = "prod" ]; then
                                    case "${APPLICATION}" in
                                        inventory-api) PORT=8104 ;;
                                        inventory-web) PORT=8204 ;;
                                        reporting-service) PORT=8304 ;;
                                    esac
                                fi

                                echo "Checking port ${PORT}"

                                curl \
                                    --fail \
                                    --silent \
                                    --show-error \
                                    --max-time 30 \
                                    "http://localhost:${PORT}/health"

                                if [ $? -eq 0 ]; then
                                    echo "Health check: SUCCESS"
                                    exit 0
                                fi

                                echo "Health check: FAILED"
                                exit 1
                            ''',
                            returnStatus: true
                        )

                        if (healthResult != 0) {

                            echo "Deployment health check failed."
                            echo "Starting automated rollback."

                            sh '''
                                set -e

                                export ANSIBLE_USER
                                export ANSIBLE_PASSWORD
                                export NEXUS_USER
                                export NEXUS_PASSWORD
                                export DB_PASSWORD

                                chmod +x ./cli/devopsctl/devopsctl

                                ./cli/devopsctl/devopsctl rollback \
                                    "${APPLICATION}" \
                                    --env "${TARGET_ENV}" \
                                    --from-version "${VERSION}"
                            '''

                            error("Deployment failed health check and was automatically rolled back")
                        }

                        echo "Deployment health verification: SUCCESS"
                    }
                }
            }
        }
    }

    post {

        success {
            echo """
========================================
RELEASE SUCCESS
========================================
Application : ${APPLICATION}
Version     : ${VERSION}
Environment : ${TARGET_ENV}
Status      : SUCCESS
========================================
"""
        }

        failure {
            echo """
========================================
RELEASE FAILED
========================================
Application : ${APPLICATION}
Version     : ${VERSION}
Environment : ${TARGET_ENV}
Status      : FAILED
========================================
"""
        }

        always {
            sh '''
                echo "Pipeline completed."
                echo "Build: ${BUILD_NUMBER}"
                echo "Commit: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
            '''
        }
    }
}
