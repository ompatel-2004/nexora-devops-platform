pipeline {
    agent any

    parameters {
        choice(name: 'APPLICATION', choices: ['inventory-api', 'inventory-web', 'reporting-service'], description: 'Application to release')
        string(name: 'VERSION', defaultValue: '1.4.2', description: 'Semantic Release Version')
        choice(name: 'TARGET_ENV', choices: ['DEV', 'QA', 'STAGING', 'PROD'], description: 'Target Deployment Environment')
        booleanParam(name: 'AUTO_APPROVE', defaultValue: false, description: 'Allow automated deployment without manual approval')
        string(name: 'SIMULATE_FAILURE', defaultValue: 'false', description: 'Inject fault for failure testing (e.g., 500)')
    }

    environment {
        NEXUS_URL    = 'http://localhost:8081/repository/nexora-releases'
        SONAR_HOST   = 'http://localhost:9000'
        BASE_DIR     = 'C:\\nexora-devops-platform'
        NEXUS_CREDS  = credentials('nexus')
        SONAR_TOKEN  = credentials('sonar-token')
    }

    stages {
        stage('Checkout & Validation') {
            steps {
                echo "[CI/CD] Checking out ${params.APPLICATION} version ${params.VERSION}"
                bat 'git status'
            }
        }

        stage('Build, Test & SonarQube Scan') {
            steps {
                script {
                    echo "[BUILD & SCAN] Compiling, running tests, and scanning: ${params.APPLICATION}"
                    if (params.APPLICATION == 'inventory-api') {
                        bat """
                            dotnet tool restore || dotnet tool install --global dotnet-sonarscanner || echo "Sonar tool ready"
                            dotnet sonarscanner begin /k:"inventory-api" /d:sonar.host.url="${SONAR_HOST}" /d:sonar.login="${SONAR_TOKEN}"
                            dotnet build "%BASE_DIR%\\applications\\inventory-api\\InventoryApi.csproj" -c Release -f net8.0
                            dotnet publish "%BASE_DIR%\\applications\\inventory-api\\InventoryApi.csproj" -c Release -f net8.0 -o "%BASE_DIR%\\applications\\inventory-api\\publish"
                            dotnet sonarscanner end /d:sonar.login="${SONAR_TOKEN}"
                        """
                    } else if (params.APPLICATION == 'reporting-service') {
                        bat """
                            cd /d "%BASE_DIR%\\applications\\reporting-service" && mvn clean test package sonar:sonar -Dsonar.host.url=${SONAR_HOST} -Dsonar.login=${SONAR_TOKEN} -Dsonar.projectKey=reporting-service
                        """
                    } else if (params.APPLICATION == 'inventory-web') {
                        bat """
                            cd /d "%BASE_DIR%\\applications\\inventory-web" && npm run build --if-present
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate Verification') {
            steps {
                powershell '''
                    $app = $env:APPLICATION
                    $token = $env:SONAR_TOKEN
                    Write-Host "[SONARQUBE] Polling Quality Gate status on $env:SONAR_HOST for $app..."

                    $auth = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes("${token}:"))
                    $headers = @{ Authorization = "Basic $auth" }
                    Start-Sleep -Seconds 4

                    try {
                        $qgUrl = "$env:SONAR_HOST/api/qualitygates/project_status?projectKey=$app"
                        $response = Invoke-RestMethod -Uri $qgUrl -Method Get -Headers $headers -TimeoutSec 15
                        $status = $response.projectStatus.status

                        Write-Host "[SONARQUBE] Live Computed Quality Gate Status: $status"
                        if ($status -ne "OK") {
                            Write-Error "[QUALITY GATE FAILED] Strict Quality Gate check failed. Status: $status"
                            exit 1
                        } else {
                            Write-Host "[QUALITY GATE PASSED] Quality Gate status verified: OK."
                        }
                    } catch {
                        Write-Error "[QUALITY GATE ERROR] SonarQube evaluation failed: $_"
                        exit 1
                    }
                '''
            }
        }

        stage('Security & SBOM Generation') {
            steps {
                powershell '''
                    $app = $env:APPLICATION
                    $ver = $env:VERSION
                    $targetDir = "$env:BASE_DIR\\artifacts\\$app"
                    if (-not (Test-Path $targetDir)) {
                        New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
                    }

                    $deps = @()
                    if ($app -eq "inventory-api") {
                        $projFile = "$env:BASE_DIR\\applications\\inventory-api\\InventoryApi.csproj"
                        [xml]$xml = Get-Content $projFile
                        foreach ($pkg in $xml.Project.ItemGroup.PackageReference) {
                            $deps += @{
                                name = $pkg.Include
                                version = $pkg.Version
                                purl = "pkg:nuget/$($pkg.Include)@$($pkg.Version)"
                            }
                        }
                    } elseif ($app -eq "reporting-service") {
                        $pomFile = "$env:BASE_DIR\\applications\\reporting-service\\pom.xml"
                        [xml]$xml = Get-Content $pomFile
                        foreach ($dep in $xml.project.dependencies.dependency) {
                            $v = $dep.version
                            if (-not $v) { $v = "3.2.4" }
                            $deps += @{
                                name = $dep.artifactId
                                version = $v
                                purl = "pkg:maven/$($dep.groupId)/$($dep.artifactId)@$v"
                            }
                        }
                    } elseif ($app -eq "inventory-web") {
                        $pkgFile = "$env:BASE_DIR\\applications\\inventory-web\\package.json"
                        if (Test-Path $pkgFile) {
                            $pkg = Get-Content $pkgFile | ConvertFrom-Json
                            if ($pkg.dependencies) {
                                foreach ($prop in $pkg.dependencies.PSObject.Properties) {
                                    $deps += @{
                                        name = $prop.Name
                                        version = $prop.Value
                                        purl = "pkg:npm/$($prop.Name)@$($prop.Value)"
                                    }
                                }
                            }
                        }
                    }

                    $sbom = @{
                        bomFormat = "CycloneDX"
                        specVersion = "1.5"
                        serialNumber = "urn:uuid:$([guid]::NewGuid())"
                        version = 1
                        metadata = @{
                            timestamp = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
                            component = @{ name = $app; version = $ver; type = "application" }
                        }
                        components = $deps
                    } | ConvertTo-Json -Depth 5

                    Set-Content -Path "$targetDir\\$app-$ver.sbom.json" -Value $sbom
                    Write-Host "[SECURITY] Generated dependency-driven CycloneDX SBOM at $targetDir\\$app-$ver.sbom.json"
                '''
            }
        }

        stage('Package & Nexus Publish') {
            steps {
                powershell '''
                    $app = $env:APPLICATION
                    $ver = $env:VERSION
                    $sourceDir = "$env:BASE_DIR\\applications\\$app"
                    $artifactDir = "$env:BASE_DIR\\artifacts\\$app"

                    if (-not (Test-Path $artifactDir)) {
                        New-Item -ItemType Directory -Path $artifactDir -Force | Out-Null
                    }

                    if ($app -eq "reporting-service") {
                        $packageFile = "$artifactDir\\$app-$ver.jar"
                        $expectedJar = "$sourceDir\\target\\reporting-service-$ver.jar"
                        if (-not (Test-Path $expectedJar)) {
                            Write-Error "[BUILD INTEGRITY ERROR] Expected artifact $expectedJar does not exist. Aborting packaging."
                            exit 1
                        }
                        Copy-Item $expectedJar $packageFile -Force
                    } elseif ($app -eq "inventory-api") {
                        $packageFile = "$artifactDir\\$app-$ver.zip"
                        Compress-Archive -Path "$sourceDir\\publish\\*" -DestinationPath $packageFile -Force
                    } elseif ($app -eq "inventory-web") {
                        $packageFile = "$artifactDir\\$app-$ver.zip"
                        Compress-Archive -Path "$sourceDir\\dist\\*" -DestinationPath $packageFile -Force
                    }

                    if (Test-Path $packageFile) {
                        $localHash = (Get-FileHash -Path $packageFile -Algorithm SHA256).Hash
                        Set-Content -Path "$artifactDir\\$app-$ver.sha256" -Value $localHash
                        Write-Host "[PACKAGE] Packaged $packageFile (SHA256: $localHash)"

                        $fileName = [System.IO.Path]::GetFileName($packageFile)
                        $nexusUri = "$env:NEXUS_URL/$app/$ver/$fileName"
                        Write-Host "[NEXUS] Publishing artifact to $nexusUri..."
                        $auth = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes("$($env:NEXUS_CREDS_USR):$($env:NEXUS_CREDS_PSW)"))
                        $headers = @{ Authorization = "Basic $auth" }

                        try {
                            Invoke-RestMethod -Uri $nexusUri -Method Put -InFile $packageFile -Headers $headers
                            Write-Host "[NEXUS UPLOAD SUCCESS] Artifact uploaded successfully."
                        } catch {
                            if ($_.Exception.Response.StatusCode.value__ -eq 400) {
                                Write-Host "[NEXUS CHECK] Artifact exists on Nexus. Verifying checksum integrity..."
                                $tempDownload = "$artifactDir\\temp-nexus-check-$fileName"
                                try {
                                    Invoke-RestMethod -Uri $nexusUri -Method Get -Headers $headers -OutFile $tempDownload
                                    $remoteHash = (Get-FileHash -Path $tempDownload -Algorithm SHA256).Hash
                                    Remove-Item $tempDownload -Force -ErrorAction SilentlyContinue

                                    if ($remoteHash -eq $localHash) {
                                        Write-Host "[NEXUS INTEGRITY VERIFIED] Existing Nexus artifact matches build checksum ($remoteHash). Reusable."
                                    } else {
                                        Write-Error "[NEXUS CHECKSUM MISMATCH] Local hash ($localHash) differs from remote ($remoteHash). Release rejected."
                                        exit 1
                                    }
                                } catch {
                                    Write-Error "[NEXUS VERIFY ERROR] Unable to retrieve existing artifact to verify checksum: $_"
                                    exit 1
                                }
                            } else {
                                Write-Error "[NEXUS UPLOAD FAILED] $_"
                                exit 1
                            }
                        }
                    } else {
                        Write-Error "[PACKAGE ERROR] Artifact file $packageFile was not created."
                        exit 1
                    }
                '''
            }
        }

        stage('Manual Approval Gate') {
            when {
                expression { return params.AUTO_APPROVE != true && params.TARGET_ENV != 'DEV' }
            }
            steps {
                input message: "Approve deployment of ${params.APPLICATION} v${params.VERSION} to ${params.TARGET_ENV}?"
            }
        }

        stage('Ansible Orchestrated Deployment') {
            steps {
                script {
                    echo "[ANSIBLE] Executing deployment for ${params.APPLICATION} via devopsctl"
                    bat """
                        wsl.exe bash -c "cd /mnt/c/nexora-devops-platform && ./cli/devopsctl/devopsctl deploy '${params.APPLICATION}' '${params.VERSION}' --env '${params.TARGET_ENV.toLowerCase()}' --simulate-failure '${params.SIMULATE_FAILURE}'"
                    """
                }
            }
        }

        stage('Health Verification & Automated Recovery') {
            steps {
                powershell '''
                    $app = $env:APPLICATION
                    $envName = $env:TARGET_ENV.ToLower()

                    if ($app -eq "reporting-service") {
                        $url = "http://localhost:8301/health"
                    } elseif ($app -eq "inventory-web") {
                        $port = switch ($envName) {
                            "dev"     { 8201 }
                            "qa"      { 8202 }
                            "staging" { 8203 }
                            "prod"    { 8204 }
                            Default   { 8201 }
                        }
                        $url = "http://localhost:$port/"
                    } else {
                        $port = switch ($envName) {
                            "dev"     { 8101 }
                            "qa"      { 8102 }
                            "staging" { 8103 }
                            "prod"    { 8104 }
                            Default   { 8101 }
                        }
                        $url = "http://localhost:$port/health"
                    }

                    Write-Host "[HEALTH CHECK] Probing deployed instance: $url..."
                    try {
                        $response = Invoke-RestMethod -Uri $url -Method Get -TimeoutSec 5
                        Write-Host "[HEALTH VERIFIED] Application is healthy: OK"
                    } catch {
                        Write-Warning "[HEALTH FAILED] Target failed health check. Triggering AUTOMATED ROLLBACK via devopsctl..."
                        wsl.exe bash -c "cd /mnt/c/nexora-devops-platform && ./cli/devopsctl/devopsctl rollback '$app' --env '$envName' --to-version '1.4.1'"

                        Write-Host "[ROLLBACK VERIFICATION] Probing restored instance: $url..."
                        Start-Sleep -Seconds 3
                        $recoveryResponse = Invoke-RestMethod -Uri $url -Method Get -TimeoutSec 5
                        Write-Host "[ROLLBACK VERIFIED] Application successfully restored to previous stable release."
                        Write-Error "[PIPELINE TERMINATION] Release rejected due to failed health check. Automated rollback verified."
                        exit 1
                    }
                '''
            }
        }
    }

    post {
        always {
            echo "[NOTIFICATION] Pipeline execution finished."
        }
        success {
            echo "[NOTIFICATION] DEPLOYMENT_SUCCESS: ${params.APPLICATION} v${params.VERSION} verified healthy on ${params.TARGET_ENV}"
        }
        failure {
            echo "[NOTIFICATION] DEPLOYMENT_REJECTED: Health check failed; automated recovery executed."
        }
    }
}
