#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ANSIBLE_DIR="${BASE_DIR}/devops/ansible"

usage() {
    cat << USAGE
Nexora DevOps CLI Control Plane (devopsctl)
Usage:
  devopsctl deploy <app> <version> --env <env> [--simulate-failure <code>]
  devopsctl rollback <app> --env <env> [--to-version <version>]
  devopsctl backup
  devopsctl verify-backup
USAGE
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

COMMAND="$1"
shift

case "${COMMAND}" in
    deploy)
        APP="${1:-}"
        VERSION="${2:-}"
        shift 2 || usage
        ENV="dev"
        SIMULATE="false"

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --env) ENV="${2:-dev}"; shift 2 ;;
                --simulate-failure) SIMULATE="${2:-500}"; shift 2 ;;
                *) shift ;;
            esac
        done

        case "${APP}" in
            inventory-api) PLAYBOOK="${ANSIBLE_DIR}/playbooks/deploy_api.yml" ;;
            inventory-web) PLAYBOOK="${ANSIBLE_DIR}/playbooks/deploy_web.yml" ;;
            reporting-service) PLAYBOOK="${ANSIBLE_DIR}/playbooks/deploy_reporting.yml" ;;
            *) echo "Unknown application: ${APP}"; exit 1 ;;
        esac

        echo "[devopsctl] Routing deployment of ${APP} v${VERSION} to ${ENV} via ${PLAYBOOK}"
        ansible-playbook -i "${ANSIBLE_DIR}/inventory.ini" "${PLAYBOOK}" \
            -e "version=${VERSION}" -e "env=${ENV}" -e "simulate_failure=${SIMULATE}"
        ;;

    rollback)
        APP="${1:-}"
        shift || usage
        ENV="dev"
        TO_VERSION="1.4.1"

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --env) ENV="${2:-dev}"; shift 2 ;;
                --to-version) TO_VERSION="${2:-1.4.1}"; shift 2 ;;
                *) shift ;;
            esac
        done

        echo "[devopsctl] Invoking dedicated rollback workflow for ${APP} on ${ENV} to v${TO_VERSION}"
        ansible-playbook -i "${ANSIBLE_DIR}/inventory.ini" "${ANSIBLE_DIR}/playbooks/rollback.yml" \
            -e "application=${APP}" -e "env=${ENV}" -e "rollback_to=${TO_VERSION}"
        ;;

    backup)
        TIMESTAMP=$(date +%Y%m%d_%H%M%S)
        BACKUP_DIR="${BASE_DIR}/database/backups"
        mkdir -p "${BACKUP_DIR}"
        echo "[devopsctl] Creating PostgreSQL backup..."
        pg_dump -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_USER:-nexora_admin}" -d "${DB_NAME:-inventory_db}" -F p > "${BACKUP_DIR}/inventory_${TIMESTAMP}.sql"
        echo "[devopsctl] Backup created: ${BACKUP_DIR}/inventory_${TIMESTAMP}.sql"
        ;;

    verify-backup)
        echo "[devopsctl] Running ephemeral backup verification..."
        LATEST_BACKUP=$(ls -t "${BASE_DIR}/database/backups"/*.sql 2>/dev/null | head -n 1 || true)
        if [[ -z "${LATEST_BACKUP}" ]]; then
            echo "[devopsctl] No backups found to verify."; exit 1
        fi
        
        # Connect to maintenance database 'postgres' to avoid dropping the active database
        psql -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_ADMIN_USER:-postgres}" -d postgres -c "DROP DATABASE IF EXISTS inventory_verify_temp;"
        psql -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_ADMIN_USER:-postgres}" -d postgres -c "CREATE DATABASE inventory_verify_temp;"
        psql -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_USER:-nexora_admin}" -d inventory_verify_temp -f "${LATEST_BACKUP}" > /dev/null
        COUNT=$(psql -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_USER:-nexora_admin}" -d inventory_verify_temp -t -A -c "SELECT COUNT(*) FROM products;")
        psql -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U "${DB_ADMIN_USER:-postgres}" -d postgres -c "DROP DATABASE inventory_verify_temp;"
        echo "[devopsctl] Verified ${COUNT} products in backup. Status: SUCCESS"
        ;;

    *)
        usage
        ;;
esac
