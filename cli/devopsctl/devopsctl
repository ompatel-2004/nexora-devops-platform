#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ANSIBLE_DIR="${BASE_DIR}/devops/ansible"
INVENTORY="${ANSIBLE_DIR}/inventory.ini"

usage() {
    cat << USAGE
Nexora DevOps CLI Control Plane (devopsctl)

Usage:
  devopsctl deploy <app> <version> --env <env> [--simulate-failure <code>]
  devopsctl rollback <app> --env <env> [--to-version <version>] [--from-version <version>]
  devopsctl backup
  devopsctl verify-backup

Required environment variables:
  ANSIBLE_USER
  ANSIBLE_PASSWORD
  NEXUS_USER
  NEXUS_PASSWORD
  DB_PASSWORD

Optional database variables:
  DB_HOST            default: localhost
  DB_PORT            default: 5432
  DB_USER            default: nexora_admin
  DB_NAME            default: inventory_db
  DB_ADMIN_USER      default: postgres
  DB_ADMIN_PASSWORD  default: DB_PASSWORD
USAGE
    exit 1
}

require_credentials() {
    local missing=()

    [[ -n "${ANSIBLE_USER:-}" ]] || missing+=("ANSIBLE_USER")
    [[ -n "${ANSIBLE_PASSWORD:-}" ]] || missing+=("ANSIBLE_PASSWORD")
    [[ -n "${NEXUS_USER:-}" ]] || missing+=("NEXUS_USER")
    [[ -n "${NEXUS_PASSWORD:-}" ]] || missing+=("NEXUS_PASSWORD")
    [[ -n "${DB_PASSWORD:-}" ]] || missing+=("DB_PASSWORD")

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "[devopsctl] ERROR: Missing required credential variables:"
        printf '  - %s\n' "${missing[@]}"
        echo
        echo "[devopsctl] Export the credentials before running devopsctl."
        exit 1
    fi
}

validate_environment() {
    case "$1" in
        dev|qa|staging|prod)
            ;;
        *)
            echo "[devopsctl] ERROR: Invalid environment: $1"
            echo "[devopsctl] Allowed values: dev, qa, staging, prod"
            exit 1
            ;;
    esac
}

validate_application() {
    case "$1" in
        inventory-api|inventory-web|reporting-service)
            ;;
        *)
            echo "[devopsctl] ERROR: Unknown application: $1"
            exit 1
            ;;
    esac
}

run_ansible() {
    require_credentials

    local ansible_extra_vars=(
        -e "ansible_user=${ANSIBLE_USER}"
        -e "ansible_password=${ANSIBLE_PASSWORD}"
        -e "nexus_user=${NEXUS_USER}"
        -e "nexus_pass=${NEXUS_PASSWORD}"
        -e "db_password=${DB_PASSWORD}"
    )

    ansible-playbook \
        -i "${INVENTORY}" \
        "$@" \
        "${ansible_extra_vars[@]}"
}

if [[ $# -lt 1 ]]; then
    usage
fi

COMMAND="$1"
shift

case "${COMMAND}" in

    deploy)
        APP="${1:-}"
        VERSION="${2:-}"

        if [[ -z "${APP}" || -z "${VERSION}" ]]; then
            echo "[devopsctl] ERROR: Application and version are required."
            usage
        fi

        shift 2

        ENV="dev"
        SIMULATE="false"

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --env)
                    [[ $# -ge 2 ]] || usage
                    ENV="$2"
                    shift 2
                    ;;
                --simulate-failure)
                    [[ $# -ge 2 ]] || usage
                    SIMULATE="$2"
                    shift 2
                    ;;
                *)
                    echo "[devopsctl] ERROR: Unknown deploy option: $1"
                    usage
                    ;;
            esac
        done

        validate_application "${APP}"
        validate_environment "${ENV}"

        case "${APP}" in
            inventory-api)
                PLAYBOOK="${ANSIBLE_DIR}/playbooks/deploy_api.yml"
                ;;
            inventory-web)
                PLAYBOOK="${ANSIBLE_DIR}/playbooks/deploy_web.yml"
                ;;
            reporting-service)
                PLAYBOOK="${ANSIBLE_DIR}/playbooks/deploy_reporting.yml"
                ;;
        esac

        echo "[devopsctl] Routing deployment of ${APP} v${VERSION} to ${ENV}"
        echo "[devopsctl] Playbook: ${PLAYBOOK}"

        run_ansible "${PLAYBOOK}" \
            -e "version=${VERSION}" \
            -e "env=${ENV}" \
            -e "simulate_failure=${SIMULATE}"
        ;;

    rollback)
        APP="${1:-}"

        if [[ -z "${APP}" ]]; then
            echo "[devopsctl] ERROR: Application is required."
            usage
        fi

        shift

        ENV="dev"
        TO_VERSION="1.4.1"
        FROM_VERSION=""
        EXPLICIT_TO_VERSION="false"

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --env)
                    [[ $# -ge 2 ]] || usage
                    ENV="$2"
                    shift 2
                    ;;
                --to-version)
                    [[ $# -ge 2 ]] || usage
                    TO_VERSION="$2"
                    EXPLICIT_TO_VERSION="true"
                    shift 2
                    ;;
                --from-version)
                    [[ $# -ge 2 ]] || usage
                    FROM_VERSION="$2"
                    shift 2
                    ;;
                *)
                    echo "[devopsctl] ERROR: Unknown rollback option: $1"
                    usage
                    ;;
            esac
        done

        validate_application "${APP}"
        validate_environment "${ENV}"

        if [[ -n "${FROM_VERSION}" && "${EXPLICIT_TO_VERSION}" != "true" ]]; then
            require_credentials

            echo "[devopsctl] Determining previous stable release for ${APP} v${FROM_VERSION} on ${ENV}..."

            PREVIOUS_SUCCESSFUL_VERSION=$(
                PGPASSWORD="${DB_PASSWORD}" \
                psql \
                    -h "${DB_HOST:-localhost}" \
                    -p "${DB_PORT:-5432}" \
                    -U "${DB_USER:-nexora_admin}" \
                    -d "${DB_NAME:-inventory_db}" \
                    -t -A \
                    -c "
                        SELECT version
                        FROM deployments
                        WHERE application = '${APP}'
                          AND environment = '${ENV}'
                          AND status = 'SUCCESS'
                          AND version <> '${FROM_VERSION}'
                        ORDER BY completed_at DESC NULLS LAST, id DESC
                        LIMIT 1;
                    "
            )

            PREVIOUS_SUCCESSFUL_VERSION="$(echo "${PREVIOUS_SUCCESSFUL_VERSION}" | xargs)"

            if [[ -z "${PREVIOUS_SUCCESSFUL_VERSION}" ]]; then
                echo "[devopsctl] ERROR: No previous successful release found for ${APP} on ${ENV}."
                echo "[devopsctl] Cannot determine a safe automatic rollback target."
                exit 1
            fi

            TO_VERSION="${PREVIOUS_SUCCESSFUL_VERSION}"

            echo "[devopsctl] Previous stable release resolved from PostgreSQL: v${TO_VERSION}"
        fi

        echo "[devopsctl] Invoking dedicated rollback workflow"
        echo "[devopsctl] Application : ${APP}"
        echo "[devopsctl] Environment : ${ENV}"
        echo "[devopsctl] Target      : v${TO_VERSION}"

        if [[ -n "${FROM_VERSION}" ]]; then
            run_ansible "${ANSIBLE_DIR}/playbooks/rollback.yml" \
                -e "application=${APP}" \
                -e "env=${ENV}" \
                -e "rollback_to=${TO_VERSION}" \
                -e "failed_version=${FROM_VERSION}"
        else
            run_ansible "${ANSIBLE_DIR}/playbooks/rollback.yml" \
                -e "application=${APP}" \
                -e "env=${ENV}" \
                -e "rollback_to=${TO_VERSION}"
        fi
        ;;

    backup)
        require_credentials

        TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
        BACKUP_DIR="${BASE_DIR}/database/backups"
        BACKUP_FILE="${BACKUP_DIR}/inventory_${TIMESTAMP}.sql"

        mkdir -p "${BACKUP_DIR}"

        echo "[devopsctl] Creating PostgreSQL backup..."
        echo "[devopsctl] Database: ${DB_NAME:-inventory_db}"

        PGPASSWORD="${DB_PASSWORD}" \
        pg_dump \
            -h "${DB_HOST:-localhost}" \
            -p "${DB_PORT:-5432}" \
            -U "${DB_USER:-nexora_admin}" \
            -d "${DB_NAME:-inventory_db}" \
            -F p \
            > "${BACKUP_FILE}"

        echo "[devopsctl] Backup created:"
        echo "[devopsctl] ${BACKUP_FILE}"
        ;;

    verify-backup)
        require_credentials

        echo "[devopsctl] Running ephemeral backup verification..."

        BACKUP_DIR="${BASE_DIR}/database/backups"

        LATEST_BACKUP="$(
            ls -t "${BACKUP_DIR}"/*.sql 2>/dev/null |
            head -n 1 ||
            true
        )"

        if [[ -z "${LATEST_BACKUP}" ]]; then
            echo "[devopsctl] ERROR: No backups found to verify."
            exit 1
        fi

        echo "[devopsctl] Backup under test:"
        echo "[devopsctl] ${LATEST_BACKUP}"

        ADMIN_PASSWORD="${DB_ADMIN_PASSWORD:-${DB_PASSWORD}}"

        echo "[devopsctl] Dropping previous verification database if present..."

        PGPASSWORD="${ADMIN_PASSWORD}" \
        psql \
            -h "${DB_HOST:-localhost}" \
            -p "${DB_PORT:-5432}" \
            -U "${DB_ADMIN_USER:-postgres}" \
            -d postgres \
            -c "DROP DATABASE IF EXISTS inventory_verify_temp;"

        echo "[devopsctl] Creating temporary verification database..."

        PGPASSWORD="${ADMIN_PASSWORD}" \
        psql \
            -h "${DB_HOST:-localhost}" \
            -p "${DB_PORT:-5432}" \
            -U "${DB_ADMIN_USER:-postgres}" \
            -d postgres \
            -c "CREATE DATABASE inventory_verify_temp;"

        echo "[devopsctl] Restoring backup into temporary database..."

        PGPASSWORD="${DB_PASSWORD}" \
        psql \
            -h "${DB_HOST:-localhost}" \
            -p "${DB_PORT:-5432}" \
            -U "${DB_USER:-nexora_admin}" \
            -d inventory_verify_temp \
            -f "${LATEST_BACKUP}" \
            > /dev/null

        COUNT="$(
            PGPASSWORD="${DB_PASSWORD}" \
            psql \
                -h "${DB_HOST:-localhost}" \
                -p "${DB_PORT:-5432}" \
                -U "${DB_USER:-nexora_admin}" \
                -d inventory_verify_temp \
                -t -A \
                -c "SELECT COUNT(*) FROM products;"
        )"

        PGPASSWORD="${ADMIN_PASSWORD}" \
        psql \
            -h "${DB_HOST:-localhost}" \
            -p "${DB_PORT:-5432}" \
            -U "${DB_ADMIN_USER:-postgres}" \
            -d postgres \
            -c "DROP DATABASE inventory_verify_temp;"

        echo "[devopsctl] Verified ${COUNT} products in backup."
        echo "[devopsctl] Backup verification status: SUCCESS"
        ;;

    *)
        usage
        ;;
esac
